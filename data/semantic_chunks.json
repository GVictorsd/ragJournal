      "sentence_end": 5,
      "sentence_count": 2
    }
  },
  {
    "chunk_id": "journal-001_chunk_3",
    "document_id": "journal-001",
    "content": "For example, I want to learn retrieval-augmented generation by building a private journal assistant. The project should let me ask questions about old entries, retrieve relevant passages, and show the evidence used for an answer.",
    "metadata": {
      "date": "2026-01-03",
      "topic": "Career Planning",
      "entry_id": "journal-001",
      "source": "C:\\Users\\Home\\Documents\\ragJournal\\dataset\\01_2026-01-03_career_planning.md",
